# Separate opt-in image: the historical CU118 image is preserved.
FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 YOLO_CONFIG_DIR=/tmp/ultralytics YOLO_AUTOINSTALL=false \
    MODEL_PATH=/opt/ml/model/best.pt MODEL_DEVICE=cuda ENABLE_DETECTION_DEPTH=true \
    DEPTH_MODEL_PATH=/opt/ml/model/yolo26m-depth.pt
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/program
RUN pip install --no-cache-dir torch==2.11.0 torchvision==0.26.0 --index-url https://download.pytorch.org/whl/cu128
RUN pip install --no-cache-dir ultralytics==8.4.159 flask==3.1.3 waitress==3.0.2 pillow==12.1.1 && pip check
COPY serve.py detection_depth.py campus_contract.json detection_depth_policy.json ./
RUN mkdir -p /tmp/ultralytics
EXPOSE 8080
ENTRYPOINT ["python", "/opt/program/serve.py"]
CMD ["serve"]
